[Unit]
Description=GitHub Actions Runner ({{ gh_org }}.{{ inventory_hostname }})
After=network.target

[Service]
ExecStart={{ gh_actions_runner_working_directory }}/runsvc.sh
User={{ cicd_user }}
Environment="ACTIONS_RUNNER_HOOK_JOB_STARTED={{ gh_actions_home }}/cleanup_script.sh"
Environment="ACTIONS_RUNNER_HOOK_JOB_COMPLETED={{ gh_actions_home }}/cleanup_script.sh"
WorkingDirectory={{ gh_actions_runner_working_directory }}
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
